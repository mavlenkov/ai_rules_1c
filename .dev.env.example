# Параметры проекта для стандартов разработки 1С (шаблон .dev.env)
# Описание параметров и классов: dev-standards-env.md §1 (в установленном проекте — в каталоге on-demand правил активного инструмента)
#
# Скопируйте файл как .dev.env и заполните значениями проекта. Установщик 1c-rules
# создаёт .dev.env на init сам и заполняет то, что смог автодетектировать.
# .dev.env — единый источник правды для правил, команд и субагентов; параметры
# подключения к ИБ и пути к платформе в других файлах не дублируются.
# Классы: [ADVISORY] — пусто = молча применяется fallback, значение не спрашивается;
# [HIGHLY DESIRABLE для …] — спрашивается только когда запущена именно эта операция;
# [DEFAULTED: x] — пусто = x, не спрашивается; [INSTALL-TIME SELECTION] — установщик
# спрашивает один раз при создании файла.

# =============================================================================
# Раздел 1. Параметры генерации кода
# =============================================================================

# [ADVISORY] Префикс новых объектов метаданных и реквизитов; пусто = без префикса.
# Примеры: гр, лтх, рлф
PREFIX=

# [ADVISORY] Имя компании/проекта для комментариев доработки; пусто (или пустой DEVELOPER) = маркеры доработки не ставятся.
# Примеры: МояКомпания, MyCompany
COMPANY=

# [ADVISORY] Идентификатор разработчика для комментариев доработки; пусто = маркеры доработки не ставятся.
# Примеры: ИвановИ, Иванов И.И.
DEVELOPER=

# [HIGHLY DESIRABLE для кода, чувствительного к версии платформы] Минимальная версия платформы (режим совместимости); автодетект из Configuration.xml.
# Примеры: 8.3.18, 8.3.24, 8.3.25
PLATFORM_VERSION=

# [HIGHLY DESIRABLE для маркеров доработки] Шаблон открывающего комментария доработки; плейсхолдеры {COMPANY}, {DEVELOPER}, {DATE}, {TASK}.
# Примеры: // +++ {COMPANY}; {DEVELOPER}; {DATE}; {TASK}   |   // >>> {COMPANY} {DEVELOPER} {DATE} {TASK}
COMMENT_OPEN=// +++ {COMPANY}; {DEVELOPER}; {DATE}; {TASK}

# [HIGHLY DESIRABLE для маркеров доработки] Шаблон закрывающего комментария доработки; те же плейсхолдеры, {TASK} можно опустить.
# Примеры: // --- {COMPANY}; {DEVELOPER}; {DATE}; {TASK}   |   // <<< {COMPANY} {DEVELOPER} {DATE}
COMMENT_CLOSE=// --- {COMPANY}; {DEVELOPER}; {DATE}; {TASK}

# [DEFAULTED: main_configuration] Куда размещать новые объекты: main_configuration (в основную конфигурацию) | extension (в расширение).
NEW_OBJECTS_IN=main_configuration

# =============================================================================
# Раздел 2. Параметры подключения к информационной базе (команды и тесты)
# =============================================================================

# [HIGHLY DESIRABLE для любых IB-команд] Каталог установки платформы 1С (содержит bin\1cv8.exe); автодетект самой свежей версии.
# Примеры: C:\Program Files\1cv8\8.3.23.1997
PLATFORM_PATH=

# [DEFAULTED: file] Тип информационной базы: file (файловая) | server (клиент-сервер).
INFOBASE_KIND=file

# [HIGHLY DESIRABLE для /update1cbase, /getconfigfiles, /loadfrom1cbase, /deploy-and-test] Путь к файловой ИБ или строка подключения к серверной ИБ.
# Примеры: C:\Users\<user>\Documents\InfoBase (file), srv-1cv8/MyApp_Test (server)
INFOBASE_PATH=

# [DEFAULTED: без аутентификации — /N и --user опускаются] Имя пользователя ИБ.
IB_USER=

# [DEFAULTED: без пароля — /P и --password опускаются] Пароль пользователя ИБ; только dev/test-пароли, не продакшн.
IB_PASSWORD=

# [DEFAULTED: основная конфигурация] Имя расширения для операций над одним расширением.
EXTENSION_NAME=

# [DEFAULTED: режим одной цели через EXTENSION_NAME] Расширения полного снимка (cf + cfe) через запятую, порядок = порядок загрузки; используют /initproject, /restore-testbase, /build-release и режим all.
# Примеры: МоеРасширение,ПатчБСП
EXTENSION_NAMES=

# [DEFAULTED: корень репозитория] Каталог выгрузки исходников конфигурации.
EXPORT_PATH=

# [DEFAULTED: каталог cfe в корне репозитория] Корневой каталог исходников расширений: {EXTENSIONS_PATH}\<ИмяРасширения>\.
EXTENSIONS_PATH=

# [DEFAULTED: шаг данных пропускается] Путь к .dt-снимку (данные + конфигурация) — базовое состояние данных для /restore-testbase.
DT_SNAPSHOT_PATH=

# [DEFAULTED: каталог release в корне репозитория] Каталог артефактов релиза для /build-release (.cf / .cfe / .cfu); рекомендуется добавить в .gitignore.
RELEASE_PATH=

# [DEFAULTED: $env:TEMP\1cv8.log, на POSIX $TMPDIR/1cv8.log] Файл лога Designer'а.
# Примеры: E:\Temp\1cv8.log
LOG_PATH=

# [DEFAULTED: localhost] Хост управляемых MCP-серверов из content/mcp-servers.json: только имя хоста или IP, без схемы, порта и пути; установщики подставляют его вместо localhost во все обычные MCP URL, значение сохраняется при update.
# Примеры: mcp-host, 192.168.1.80
MCP_HOST=

# [DEFAULTED: $env:TEMP\1cv8.result, на POSIX $TMPDIR/1cv8.result] Файл /DumpResult пакетных запусков Конфигуратора (0 = успех).
# Примеры: E:\Temp\1cv8.result
RESULT_PATH=

# [HIGHLY DESIRABLE для UI-тестов (1c-tester, /deploy-and-test) и сервера 1c-data-mcp] URL веб-публикации тестовой ИБ; пусто = UI-тесты пропускаются; для 1c-data-mcp адрес <база>/hs/mcp должен отвечать без пароля (анонимный доступ в default.vrd).
# Примеры: http://localhost/TestForms/ru/
INFOBASE_PUBLISH_URL=

# [DEFAULTED: manual] Режим веб-тестирования UI: manual (только по явному запросу) | auto (после успешного deploy) | off (отключено).
# Примеры: manual, auto, off
UI_TESTING=

# [INSTALL-TIME SELECTION] Используется ли 1C:EDT в проекте: true (действует edt-workflow.md, рекомендуется EDT-MCP) | false.
# Примеры: true, false
USE_EDT=false

# [DEFAULTED: fallback на Designer] Путь к config.yml автономного сервера 1С для операций через ibcmd (нужен ещё {PLATFORM_PATH}\bin\ibcmd.exe; для кластерной ИБ неприменим).
# Примеры: C:\Users\<user>\1cv8\standalone\config.yml
IBCMD_CONFIG=

# [DEFAULTED: без доп. аргументов] Дополнительные аргументы запуска 1cv8.exe через запятую (инструменты db-* / epf-* скилла 1c-metadata-manage); аргументы, которыми управляет сам инструмент, отклоняются.
# Примеры: /UseHwLicenses+, /ClearCache
PLATFORM_ARGS=

# [DEFAULTED: без доп. аргументов] Дополнительные аргументы ibcmd через запятую (форма --ключ=значение).
# Примеры: --dbms=PostgreSQL
IBCMD_ARGS=

# [DEFAULTED: deny] Реакция гейта поддержки поставщика в мутирующих инструментах 1c-metadata-manage: deny (отклонить) | warn (предупредить и выполнить) | off.
# Примеры: deny, warn, off
SUPPORT_GUARD=

# [DEFAULTED: end] Куда инструменты-создатели скилла 1c-metadata-manage ставят новый объект в <ChildObjects> файла Configuration.xml: end (после последнего объекта того же вида, как Конфигуратор) | byName (по имени внутри своего вида, стандарт АПК:1108). Группа нового вида всегда встаёт в канонический порядок видов; Subsystem, CommandGroup, CommonAttribute и Language по имени не сортируются; уже существующие объекты не переставляются.
# Примеры: byName
NEW_OBJECT_POSITION=

# [DEFAULTED: конфигурация не подключена к хранилищу] Адрес хранилища конфигурации; непустое значение включает режим хранилища (скилл 1c-repository-manage), отключать конфигурацию от хранилища при этом запрещено.
# Примеры: C:\1C\Repository, tcp://repo-server/MyApp
REPOSITORY_PATH=

# [DEFAULTED: флаги /ConfigurationRepositoryN и /ConfigurationRepositoryP опускаются] Пользователь и пароль хранилища; не храните продакшн-пароли.
REPOSITORY_USER=
REPOSITORY_PASSWORD=

# [DEFAULTED: false] Разрешение на -force операции с хранилищем (первая половина двойного подтверждения); меняет только пользователь на время обслуживания.
# Примеры: true
REPOSITORY_ALLOW_FORCE=

# =============================================================================
# Раздел 3. Модель головного агента, модели субагентов и режим оркестрации
# =============================================================================

# [DEFAULTED: без профиля — базовый свод правил] Модель головного агента для адаптации правил: opus5 | sonnet5 | fable5 | gpt56 | gpt6; редактирует команда /rulesmodel. Не путать с SUBAGENT_MODEL_*.
# Примеры: opus5, sonnet5, fable5, gpt56, gpt6
AGENT_MODEL=

# [DEFAULTED: модель AI-клиента по умолчанию] Модель яруса coding (авторство кода и метаданных, архитектура) в формате id вашего AI-клиента; после правки — install.ps1 update (перерендер субагентов).
SUBAGENT_MODEL_CODING=

# [DEFAULTED: модель AI-клиента по умолчанию] Модель яруса analysis (постановка, аналитика, ревью, тесты, документация); формат id — как у клиента.
SUBAGENT_MODEL_ANALYSIS=

# [DEFAULTED: модель AI-клиента по умолчанию] Модель яруса light (разведка репозитория, поиск, списки использования — только чтение); формат id — как у клиента.
SUBAGENT_MODEL_LIGHT=
# --- Per-client override (суффикс __<TOOL>; форк mavlenkov) ------------------
# Имя модели диалектно по AI-клиенту: Claude Code/Cursor принимают короткий
# алиас (`sonnet`, `opus`), OpenCode/Kilo Code требуют `provider/model`
# (`zai-coding-plan/glm-5.2`), голый алиас там НЕ резолвится. Для каждого
# яруса можно задать override на клиента суффиксом `__<TOOL>` (TOOL в ВЕРХНЕМ
# регистре, дефис -> подчёркивание): SUBAGENT_MODEL_CODING__OPENCODE,
# SUBAGENT_MODEL_CODING__CLAUDE_CODE, __CURSOR, __KILOCODE, __CODEX.
# Каскад: SUBAGENT_MODEL_<TIER>__<TOOL> -> SUBAGENT_MODEL_<TIER> -> пусто.
# Для OpenCode/Kilo имя без `/` не подставляется (WARNING). Codex принимает
# свои slug'и моделей без провайдера (`gpt-5.6-sol` и т.п.).
# Семантика яруса зависит от биллинга: per-token (Claude Code) = стоимость x
# способность; flat-подписка (OpenCode/Z.AI) = способность x латентность,
# ярусы могут совпадать.
# Per-client override (fork): cascade `__<TOOL>` -> bare tier -> empty; for
# OpenCode/Kilo a name without `/` is skipped with a WARNING.
# Примеры / Examples:
# SUBAGENT_MODEL_CODING__CLAUDE_CODE=sonnet
# SUBAGENT_MODEL_CODING__OPENCODE=deepseek/deepseek-v4-pro
# SUBAGENT_MODEL_CODING__CODEX=gpt-5.6-sol
# SUBAGENT_MODEL_ANALYSIS__CLAUDE_CODE=opus
# SUBAGENT_MODEL_ANALYSIS__OPENCODE=zai-coding-plan/glm-5.2
# SUBAGENT_MODEL_ANALYSIS__CODEX=gpt-5.6-terra
# SUBAGENT_MODEL_LIGHT__CLAUDE_CODE=haiku
# SUBAGENT_MODEL_LIGHT__OPENCODE=zai-coding-plan/glm-5-turbo
# SUBAGENT_MODEL_LIGHT__CODEX=gpt-5.6-luna

# [DEFAULTED: standard] Режим оркестрации: standard (обычное делегирование) | economy (головной агент делегирует чтение и запись субагентам); редактирует команда /economymode.
# Примеры: standard, economy
ORCHESTRATION=

# =============================================================================
# Раздел 4. Параметры процесса разработки (триаж и отладка)
# =============================================================================

# [DEFAULTED: 40] Лимит изменённых строк BSL для пути quick-fix (AGENTS.md → Triage); триггеры промоции всегда сильнее лимита.
# Примеры: 20, 40, 60
QUICKFIX_MAX_LINES=

# [DEFAULTED: standard] Режим быстрого пути отладки: standard | extended (репро из отчёта пользователя, регрессия своей же правки) | off (всегда полный 4-фазный цикл).
# Примеры: standard, extended, off
DEBUG_FAST_PATH=

# [DEFAULTED: standard] Глубина проверок кода: full | standard | lite (syntaxcheck всегда; check_1c_code / review_1c_code — только для высокорисковых правок); редактирует команда /litemode.
# Примеры: full, standard, lite
VERIFICATION_DEPTH=

# [DEFAULTED: auto] Автовключение стиля общения caveman: auto (только задачи разработки) | on (все задачи) | off (только по явной команде сессии); редактирует команда /caveman.
# Примеры: on, auto, off
CAVEMAN=

# [DEFAULTED: auto] Когда запускать preview метаданных через Invoke-1CEdit -Preview: auto (только генерация из DSL и незнакомая операция) | on (перед каждой записью через обёртку) | off (только по явному запросу); редактирует команда /previewmode. Удаления по-прежнему требуют своего -DryRun / -Force.
# Примеры: auto, on, off
METADATA_PREVIEW=

# =============================================================================
# Раздел 5. Linux + 1CFilesConverter (ТОЛЬКО форк mavlenkov/ai_rules_1c)
# Section 5. Linux + 1CFilesConverter (FORK-ONLY: mavlenkov/ai_rules_1c)
# =============================================================================
#
# Эти параметры используются ТОЛЬКО форк-командами /deploy-and-test,
# /getconfigfiles, /extensions, /dataprocessors при работе через
# 1CFilesConverter (Mode 1). В upstream comol/ai_rules_1c этого раздела нет.
# Если 1CFilesConverter не используется, оставьте раздел пустым — команды
# откатятся на прямой вызов Designer (Mode 2; для /extensions и
# /dataprocessors часть операций без конвертера недоступна).
#
# These parameters are used ONLY by the fork commands /deploy-and-test,
# /getconfigfiles, /extensions, /dataprocessors when working through
# 1CFilesConverter (Mode 1). Upstream comol/ai_rules_1c has no such section.
# Leave empty if 1CFilesConverter is not used — commands fall back to a direct
# Designer call (Mode 2).
#
# Версия платформы (V8_VERSION для скриптов конвертера) НЕ дублируется здесь —
# команды извлекают её как basename(PLATFORM_PATH) из Раздела 2
# (например, /opt/1cv8/x86_64/8.3.27.1859 → 8.3.27.1859).
# Platform version (V8_VERSION for converter scripts) is NOT duplicated here —
# commands derive it as basename(PLATFORM_PATH) from Section 2.

# [HIGHLY DESIRABLE для Mode 1] Путь к установленному 1CFilesConverter.
# Каталог должен содержать scripts/conf2ib.sh, ext2ib.sh, conf2xml.sh и пр.
# Если пусто или путь невалиден — команды используют Mode 2 (прямой Designer).
# Path to the installed 1CFilesConverter (must contain scripts/conf2ib.sh etc.).
# Empty or invalid → commands use Mode 2 (direct Designer).
# Примеры / Examples: /home/user/Проекты/1CFilesConverter
CONVERTER_PATH=

# [DEFAULTED] Инструмент конвертации: designer | ibcmd. Пусто = designer.
# → передаётся скриптам конвертера как V8_CONVERT_TOOL.
# Conversion tool: designer | ibcmd. Empty = designer.
# → passed to converter scripts as V8_CONVERT_TOOL.
CONVERT_TOOL=designer

# [DEFAULTED] Путь к бинарю ibcmd (если CONVERT_TOOL=ibcmd и путь нестандартный).
# Пусто → default /opt/1cv8/x86_64/<version>/ibcmd. → IBCMD_TOOL.
# Path to the ibcmd binary (when CONVERT_TOOL=ibcmd and the path is non-default).
# Empty → defaults to /opt/1cv8/x86_64/<version>/ibcmd.
IBCMD_TOOL=

# --- Параметры сервера БД (нужны для CONVERT_TOOL=ibcmd + серверная ИБ) ---
# --- DB server parameters (needed for CONVERT_TOOL=ibcmd + server infobase) ---
# СУБД: MSSQLServer | PostgreSQL. → V8_DB_SRV_DBMS.
# DBMS: MSSQLServer | PostgreSQL.
DB_SRV_DBMS=
# Адрес сервера БД (для именованных инстансов MSSQL). → V8_DB_SRV_ADDR.
# DB server address (for named MSSQL instances). Примеры / Examples: DBSRVHOST\SQL2019
DB_SRV_ADDR=
# Пользователь сервера БД. → V8_DB_SRV_USR.   DB server user.
DB_SRV_USR=
# Пароль сервера БД. → V8_DB_SRV_PWD.         DB server password.
DB_SRV_PWD=

# --- Удалённый ibcmd через SSH (для MSSQL-серверной ИБ на Linux) ---
# --- Remote ibcmd over SSH (for MSSQL-backed server infobase on Linux) ---
# ibcmd на Linux не поддерживает MSSQL — операция проксируется на Windows-хост
# по SSH. SSH-хост с ibcmd. → V8_REMOTE_HOST.
# ibcmd on Linux does not support MSSQL — the operation is proxied to a Windows
# host over SSH. SSH host with ibcmd.
REMOTE_HOST=
# Путь к ibcmd.exe на удалённом хосте. → V8_REMOTE_IBCMD.
# Path to ibcmd.exe on the remote host.
# По умолчанию / Default: C:\Program Files\1cv8\<version>\bin\ibcmd.exe
REMOTE_IBCMD=
# Временный каталог на удалённом хосте. → V8_REMOTE_TEMP.
# Temp directory on the remote host. По умолчанию / Default: C:\Temp\1c_conv
REMOTE_TEMP=

# --- Базовая конфигурация для внешних обработок/отчётов (/dataprocessors) ---
# --- Base configuration for external data processors/reports (/dataprocessors) ---
# Внешним обработкам/отчётам нужен контекст базовой конфигурации для компиляции.
# Укажите ОДНО из двух. External processors/reports need a base configuration
# context for compilation. Provide ONE of the two.
# Путь к ИБ с базовой конфигурацией. → V8_BASE_IB. Примеры: /F/tmp/base_ib
BASE_IB=
# Путь к CF-файлу базовой конфигурации. → V8_BASE_CONFIG. Примеры: /path/to/1cv8.cf
BASE_CONFIG=

# [DEFAULTED] Версия 1C:EDT для конвертации в EDT (ext2edt.sh / dp2edt.sh).
# → V8_EDT_VERSION. Требует установленных EDT-инструментов (ring / edtcli).
# 1C:EDT version for EDT conversion (ext2edt.sh / dp2edt.sh).
# Requires installed EDT tooling (ring / edtcli).
EDT_VERSION=

# =============================================================================
# Раздел 6. Канал поддержки: обращения по MCP-серверам и правилам
# Section 6. Support channel: tickets about MCP servers and the ruleset
#
# ВАЖНО (форк): в upstream comol/ai_rules_1c это Раздел 5 (там нет
# форк-Раздела 5 с 1CFilesConverter); здесь канал поддержки — Раздел 6.
# При следующем merge upstream держите эту пометку в голове.
# NOTE (fork): upstream numbers this section as Section 5 (it has no fork
# Section 5 for 1CFilesConverter); here it is Section 6.
# =============================================================================

# [HIGHLY DESIRABLE для /support] Общий ключ поддержки из раздела 6 config.env дистрибутива MCP; СЕКРЕТ — не публикуется в чате, логах и тексте обращения.
SUPPORT_KEY=

# [HIGHLY DESIRABLE для /support] Рабочий e-mail автора обращений; на него отвечает оператор, по нему /supportstatus отбирает тикеты.
# Примеры: dev@example.com
SUPPORT_EMAIL=

# [DEFAULTED: https://d5ds85pood7ob80g5fd9.nnekmrav.apigw.yandexcloud.net] Адрес сервиса поддержки; заполняется только для собственного экземпляра.
SUPPORT_API_URL=
